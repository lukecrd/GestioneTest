# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: GitHub Personal Access Token per la sincronizzazione (push/pull) con il repository GitHub
GITHUB_TOKEN="MY_GITHUB_TOKEN"

# Salvataggio della Tabella informazioni su Google Drive (src/lib/drive.ts).
# Copia in .env.local (sviluppo) e nelle Environment Variables di Vercel (produzione).
# Client OAuth "Applicazione web" di Google Cloud, con origini JavaScript autorizzate:
#   http://localhost:3000 e il dominio dell'app pubblicata.
VITE_GOOGLE_CLIENT_ID=
# Account Google sul cui Drive si salva (l'app rifiuta gli altri account).
VITE_DRIVE_ACCOUNT=
