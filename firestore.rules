rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo account con email verificata: impedisce di registrarsi con l'indirizzo di un altro.
    function autenticato() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function profilo() {
      return get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data;
    }

    function haProfilo() {
      return exists(/databases/$(database)/documents/utenti/$(request.auth.uid));
    }

    function membro() {
      return autenticato() && haProfilo() && profilo().ruolo in ['viewer', 'admin'];
    }

    function amministratore() {
      return autenticato() && haProfilo() && profilo().ruolo == 'admin';
    }

    // ⚠ PRIMO AMMINISTRATORE: stessa email di EMAIL_AMMINISTRATORE_INIZIALE in src/lib/utenti.ts.
    function amministratoreIniziale() {
      return request.auth.token.email == 'luca.cardelli@gmail.com';
    }

    // Permesso "modifica" su un programma, assegnato dall'amministratore nel profilo (campo permessi).
    function permesso(programma) {
      return membro() && profilo().get('permessi', {}).get(programma, '') == 'modifica';
    }

    // Chiavi cambiate dentro una mappa del documento (state o activePrograms).
    function cambiate(campo) {
      return request.resource.data.get(campo, {}).diff(resource.data.get(campo, {})).affectedKeys();
    }

    function soloSe(chiavi, elenco, programma) {
      return !chiavi.hasAny(elenco) || permesso(programma);
    }

    // Chi ha permessi su singoli programmi tocca solo quelle parti (stesso elenco di chiaviStatoModificabili).
    function modificaProgrammi() {
      let s = cambiate('state');
      let ap = cambiate('activePrograms');
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'activePrograms', 'updatedAt'])
        && s.hasOnly(['mensileArchives', 'vitaEMinistero', 'discorsiEsterni', 'servizioCampo', 'operaPubblica', 'territori'])
        && ap.hasOnly(['menPrograms', 'menRows', 'menTitle', 'menWarn', 'menMonth', 'menYear',
                       'domPrograms', 'domRows', 'domTitle', 'domWarn', 'domMonth', 'domYear'])
        && soloSe(s, ['mensileArchives'], 'mensile')
        && soloSe(s, ['vitaEMinistero'], 'vitaEMinistero')
        && soloSe(s, ['discorsiEsterni'], 'discorsiEsterni')
        && soloSe(s, ['servizioCampo'], 'servizioCampo')
        && soloSe(s, ['operaPubblica'], 'operaPubblica')
        && soloSe(s, ['territori'], 'territori')
        && soloSe(ap, ['menPrograms', 'menRows', 'menTitle', 'menWarn', 'menMonth', 'menYear'], 'mensile')
        && soloSe(ap, ['domPrograms', 'domRows', 'domTitle', 'domWarn', 'domMonth', 'domYear'], 'domenica')
        && (s.size() > 0 || ap.size() > 0);
    }

    // Dati della congregazione: li legge chi è approvato; li modifica un amministratore,
    // oppure chi ha il permesso sul programma che sta cambiando.
    match /congregationData/{docId} {
      allow read: if membro();
      allow write: if amministratore();
      allow update: if modificaProgrammi();
    }

    // PDF della Tabella informazioni (src/lib/allegati.ts): li legge chi è approvato, li gestisce l'amministratore.
    match /allegati/{id} {
      allow read: if membro();
      allow create, update: if amministratore()
        && request.resource.data.keys().hasOnly(['nome', 'dati', 'caricato'])
        && request.resource.data.dati is string
        && request.resource.data.dati.matches('data:application/pdf;base64,.*');
      allow delete: if amministratore();
    }

    match /utenti/{uid} {
      allow read: if autenticato() && (request.auth.uid == uid || amministratore());

      // Ognuno crea solo il proprio profilo, con la propria email, e sempre "in attesa"
      // (tranne il primo amministratore).
      allow create: if autenticato()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'nome', 'ruolo', 'creato'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 80
        && (request.resource.data.ruolo == 'in_attesa'
            || (request.resource.data.ruolo == 'admin' && amministratoreIniziale()));

      // L'utente può cambiare solo il proprio nome. Un amministratore cambia ruolo e permessi degli altri,
      // mai il proprio (così non resta chiuso fuori per sbaglio).
      allow update: if (autenticato()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome']))
        || (amministratore()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ruolo', 'permessi'])
          && request.resource.data.ruolo in ['in_attesa', 'viewer', 'admin']
          && request.resource.data.get('permessi', {}) is map);

      allow delete: if amministratore() && request.auth.uid != uid;
    }
  }
}
